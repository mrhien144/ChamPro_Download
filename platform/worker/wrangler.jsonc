{
  // STAGING ONLY. Do not reuse the production website domain for this Worker.
  "name": "champro-platform-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "preview_urls": false,
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "champro-platform-staging",
      "database_id": "e4dc2b7c-8737-4dc2-8c6c-b34ffdd6de6c",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHEET_PHOTOS",
      "bucket_name": "champro-photos-staging"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://champro.mrhien.com,https://mrhien.com",
    "ADMIN_WP_USER_IDS": "1",
    "PRODUCT_ANNUAL_ID": "8919",
    "PRODUCT_LIFETIME_ID": "8920"
  }
}
