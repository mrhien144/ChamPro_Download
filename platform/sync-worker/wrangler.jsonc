{
  // Isolated sync Worker. NEVER overwrite the payment/licensing Worker.
  "name": "champro-sync-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "champro-platform-staging",
      "database_id": "e4dc2b7c-8737-4dc2-8c6c-b34ffdd6de6c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "champro-photos-staging"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://champro.mrhien.com,https://mrhien.com,https://localhost",
    "CHAMPRO_SYNC_ENABLED": "0",
    "CHAMPRO_SYNC_QA_ONLY": "1",
    "CHAMPRO_SYNC_QA_WP_IDS": ""
  }
}
